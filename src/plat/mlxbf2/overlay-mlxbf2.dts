/ {
	chosen {
		seL4,elfloader-devices =
		    &{/tmfifo@800a20},
		    &{/psci},
		    &{/timer};
		seL4,kernel-devices =
		    &{/tmfifo@800a20},
		    &{/interrupt-controller@12000000},
		    &{/timer};
		stdout-path = "/tmfifo@800a20";
	};
};
